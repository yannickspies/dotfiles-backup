{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "agent-architecture-audit": "off",
    "agent-eval": "off",
    "agent-harness-construction": "off",
    "agent-introspection-debugging": "off",
    "agentic-engineering": "off",
    "agentic-os": "off",
    "ai-first-engineering": "off",
    "ai-regression-testing": "off",
    "angular-developer": "off",
    "api-design": "off",
    "architecture-decision-records": "off",
    "article-writing": "off",
    "autonomous-agent-harness": "off",
    "autonomous-loops": "off",
    "backend-patterns": "off",
    "brand-voice": "off",
    "browser-qa": "off",
    "code-tour": "off",
    "codebase-onboarding": "off",
    "coding-standards": "off",
    "configure-ecc": "off",
    "content-engine": "off",
    "context-budget": "off",
    "continuous-agent-loop": "off",
    "continuous-learning-v2": "off",
    "cost-aware-llm-pipeline": "off",
    "cost-tracking": "off",
    "crosspost": "off",
    "database-migrations": "off",
    "deployment-patterns": "off",
    "design-system": "off",
    "docker-patterns": "off",
    "e2e-testing": "off",
    "ecc-guide": "off",
    "ecc-tools-cost-audit": "off",
    "error-handling": "off",
    "eval-harness": "off",
    "exa-search": "off",
    "frontend-design-direction": "off",
    "frontend-patterns": "off",
    "frontend-slides": "off",
    "git-workflow": "off",
    "github-ops": "off",
    "hexagonal-architecture": "off",
    "hookify-rules": "off",
    "iterative-retrieval": "off",
    "knowledge-ops": "off",
    "liquid-glass-design": "off",
    "make-interfaces-feel-better": "off",
    "plankton-code-quality": "off",
    "pr-summary-dutch": "off",
    "production-audit": "off",
    "prompt-optimizer": "off",
    "python-patterns": "off",
    "python-testing": "off",
    "repo-scan": "off",
    "research-ops": "off",
    "rules-distill": "off",
    "safety-guard": "off",
    "search-first": "off",
    "security-bounty-hunter": "off",
    "security-review": "off",
    "security-scan": "off",
    "skill-comply": "off",
    "skill-scout": "off",
    "skill-stocktake": "off",
    "strategic-compact": "off",
    "tdd-workflow": "off",
    "team-builder": "off",
    "token-budget-advisor": "off",
    "verification-loop": "off",
    "workspace-surface-audit": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/user_prompt_submit.py --log-only"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/post_tool_use.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/notification.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/stop.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/subagent_stop.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_compact.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/session_start.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run ~/.claude/hooks/cost_statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "code-review@claude-code-plugins": false,
    "learning-output-style@claude-code-plugins": false
  },
  "outputStyle": "Decision First",
  "alwaysThinkingEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "effortLevel": "xhigh"
}
